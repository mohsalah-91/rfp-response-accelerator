# Application Lifecycle Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local pgvector container password, read by docker-compose.yml
POSTGRES_PASSWORD=CHANGE_ME

# Vector database URL (use the same password as POSTGRES_PASSWORD)
DATABASE_URL=postgresql://rag_admin:CHANGE_ME@localhost:5433/ai_enterprise_db

# AI Provider Credentials
OPENAI_API_KEY=sk-...
COHERE_API_KEY=...

# Pipeline Hyperparameters
EMBEDDING_MODEL=text-embedding-3-small
ANSWER_MODEL=gpt-5
RAG_DEFAULT_TOP_K=3
